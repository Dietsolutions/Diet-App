{
  "name": "diet-app-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --schema=src/prisma/schema.prisma && tsc",
    "start": "node dist/src/server.js",
    "seed": "tsx src/seed.ts",
    "prisma:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=src/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=src/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=src/prisma/schema.prisma",
    "db:apply-neon": "echo 'See NEON_MIGRATION_README.md. This script is a no-op because the Neon DB is unreachable from this dev env.'",
    "seed:indian": "tsx src/scripts/seedIndianFoodDatabases.ts",
    "seed:kaggle": "tsx src/scripts/seedKaggleIndianFoods.ts",
    "query:validation": "tsx src/scripts/queryValidationData.ts",
    "query:attempts": "tsx src/scripts/queryAttemptDetail.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@vercel/blob": "^2.3.3",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.3",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ifct2017": "^2.0.15",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.10",
    "openai": "^6.41.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/morgan": "^1.9.10",
    "@types/nodemailer": "^8.0.0",
    "prisma": "^5.22.0",
    "typescript": "^5.3.3",
    "xlsx": "^0.18.5"
  }
}
