# ── Database (Neon Postgres) ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/db?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-random-64-char-string"

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
NODE_ENV=development

# ── LLM Provider ──────────────────────────────────────────────────────────
# Set either OPENROUTER_API_KEY (preferred) or ANTHROPIC_API_KEY
OPENROUTER_API_KEY="sk-or-v1-your-key-here"
# ANTHROPIC_API_KEY="sk-ant-your-key-here"
CLAUDE_MODEL="openai/gpt-4o-mini"

# ── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# ── Optional services (leave blank to disable) ────────────────────────────
USDA_API_KEY=
CALORIE_NINJAS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── SMTP (email) ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@dietplan.app

# ── Apple Sign-In ──────────────────────────────────────────────────────────
APPLE_CLIENT_ID=com.dietplan.tracker

# ── Seed data ──────────────────────────────────────────────────────────────
SEED_USERNAME=harshit
SEED_PASSWORD=change-this-password
SEED_NAME=Harshit
REVIEW_USERNAME=review
REVIEW_PASSWORD=Review@2026!

# ── Android signing (used by build.gradle) ─────────────────────────────────
ANDROID_KEYSTORE_FILE=android/app/diet-plan-release.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=diet-plan-release
ANDROID_KEY_PASSWORD=

# ── Apple (used by capacitor.config.ts) ────────────────────────────────────
APPLE_TEAM_ID=
