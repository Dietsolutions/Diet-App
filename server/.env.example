# Database
DATABASE_URL="file:./dev.db"

# JWT secret for auth tokens
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# Server port
PORT=3001

# Frontend URL (for CORS)
CLIENT_URL="http://localhost:5173"
NODE_ENV=development

# Google OAuth 2.0 — get from console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# Anthropic API — get from console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Frontend redirect URL
FRONTEND_URL=http://localhost:5173

# USDA FoodData Central API (free key at fdc.nal.usda.gov/api-key-signup.html)
# Used in food search waterfall (Step 5). Silently skipped when absent.
USDA_API_KEY=your_usda_key_here

# CalorieNinjas Nutrition API (free tier: 100 calls/day — calorieninjas.com/api)
# Used for: (1) post-plan macro verification, (2) food search waterfall Step 4.
# Gracefully skipped when absent.
CALORIE_NINJAS_API_KEY=

# Daily cap on explicit AI food estimate calls per user (default 20).
# The search-fallback AI path is separately rate-limited to 5 calls/user/hour.
AI_FOOD_ESTIMATE_DAILY_LIMIT=20
