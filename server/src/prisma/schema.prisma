// Prisma schema — PostgreSQL (Neon) for both local dev and Vercel production.
// `schema.postgres.prisma` is kept as a backup copy of this file. A SQLite
// variant is preserved in git history if you ever need to revert.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String    @id @default(cuid())
  username       String?   @unique
  email          String?   @unique
  passwordHash   String?
  googleId       String?   @unique
  name           String?
  avatar         String?
  onboardingDone Boolean   @default(false)
  createdAt      DateTime  @default(now())

  mealLogs       MealLog[]
  shoppingItems  ShoppingItem[]
  planWeeks      PlanWeek[]
  profile        UserProfile?
  mealPlans      MealPlan[]
  generatedShoppingLists GeneratedShoppingList[]
  weightLogs     WeightLog[]
  mealReplacements MealReplacement[]
  recentFoodLogs   RecentFoodLog[]
  waterLogs        WaterLog[]
  additionalMealLogs AdditionalMealLog[]
  cookingInstructions MealCookingInstructions[]
  planGenerationUsage PlanGenerationUsage[]
  macroValidationLogs MacroValidationLog[]
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  weightKg  Float
  loggedAt  DateTime @default(now())
  note      String?  @default("")
  createdAt DateTime @default(now())

  @@index([userId, loggedAt])
}

model UserProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  name                 String
  age                  Int
  gender               String
  country              String
  city                 String
  weightKg             Float
  heightCm             Float
  targetWeightKg       Float?                // null for eat_healthy / no weight target
  mealPreference       String
  cuisinePreferences   String   @default("[]")
  mealsPerDay          Int      @default(4)
  eatingWindow         String   @default("standard")
  allergies            String   @default("[]")
  preferredIngredients String   @default("[]")
  avoidIngredients     String   @default("[]")
  primaryGoal          String
  dietIntensity        String?               // null for goals that do not require a deficit magnitude
  activityLevel        String
  healthConditions     String   @default("[]")
  tdee                 Float
  targetCalories       Float
  proteinTarget        Float
  fatTarget            Float
  carbTarget           Float
  fibreTarget          Float
  wakeUpTime           String   @default("07:00")
  sleepTime            String   @default("23:00")
  cookingStyle         String   @default("home")
  kitchenEquipment     String   @default("[]")
  weeklyBudget         Float?
  budgetCurrency       String   @default("INR")
  waterIntakeGoal      Int      @default(8)
  mealPlanCustomInstructions  String?  @default("")
  customInstructionsUpdatedAt DateTime?
  planDuration         Int      @default(7)
  countryCode          String?
  eatingWindowHours    Int?
  fastingWindowHours   Int?
  eatingStartTime      String?
  eatingEndTime        String?
  unitSystem           String   @default("metric")  // "metric" | "imperial"

  // Group A — TDEE inputs (applied to calorie/macro calculation)
  trainingType           String?  @default("none")       // strength | endurance | crossfit | mixed | none
  trainingDaysPerWeek    Int?     @default(3)
  trainingDurationMins   Int?     @default(45)
  cardioSessionsPerWeek  Int?     @default(0)
  dailySteps             Int?     @default(5000)
  occupationType         String?  @default("desk_job")   // desk_job | active_job | manual_labour
  insulinSensitivity     String?  @default("average")    // good | average | poor

  // Group B — Meal plan context inputs (passed to Claude prompt, not TDEE)
  sleepQuality           String?  @default("average")    // good | average | poor
  stressLevel            String?  @default("medium")     // low | medium | high
  recoveryCapacity       String?  @default("average")    // excellent | average | poor
  hungerLevel            String?  @default("medium")     // low | medium | high
  energyLevel            String?  @default("moderate")   // high | moderate | low

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model MealPlan {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  weekStartDate     DateTime
  generatedAt       DateTime      @default(now())
  isActive          Boolean       @default(true)
  weekSummary       String        @default("{}")
  planDuration      Int           @default(7)
  cnChecks          Int           @default(0)   // total CalorieNinjas API calls made during generation
  cnCorrections     Int           @default(0)   // total Claude correction calls made during generation
  mealPrepGuide     Json?
  reviewConfirmed   Boolean       @default(false)
  reviewConfirmedAt DateTime?
  days              MealPlanDay[]
  shoppingLists     GeneratedShoppingList[]
}

model MealPlanDay {
  id            String   @id @default(cuid())
  mealPlanId    String
  mealPlan      MealPlan @relation(fields: [mealPlanId], references: [id])
  dayIndex      Int
  dayName       String
  totalCalories Float
  totalProtein  Float
  totalCarbs    Float
  totalFat      Float
  totalFibre    Float
  meals         String   @default("[]")
}

model GeneratedShoppingList {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  mealPlanId  String
  mealPlan    MealPlan @relation(fields: [mealPlanId], references: [id])
  categories  String   @default("[]")
  peopleCount Int      @default(1)
  createdAt   DateTime @default(now())
}

model MealLog {
  id        Int      @id @default(autoincrement())
  userId    String
  date      String
  dayIndex  Int
  mealIndex Int
  eaten     Boolean  @default(false)
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date, mealIndex])
}

model ShoppingItem {
  id        Int      @id @default(autoincrement())
  userId    String
  itemKey   String
  bought    Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, itemKey])
}

model PlanWeek {
  id            Int    @id @default(autoincrement())
  userId        String
  weekStartDate String
  user          User   @relation(fields: [userId], references: [id])
}

model MealReplacement {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date           String
  dayIndex       Int
  mealIndex      Int

  foodName       String
  foodSource     String
  foodExternalId String?

  servingSize    String
  servingQty     Float
  servingGrams   Float?

  calories       Float
  proteinG       Float
  carbsG         Float
  fatG           Float
  fibreG         Float

  note           String?  @default("")
  isAiEstimate   Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date, mealIndex])
  @@index([userId, date])
  @@map("meal_replacements")
}

model FoodSearchCache {
  id        String   @id @default(cuid())
  query     String
  source    String
  results   Json
  cachedAt  DateTime @default(now())
  expiresAt DateTime

  @@unique([query, source])
  @@index([query, source])
  @@index([expiresAt])
  @@map("food_search_cache")
}

model IndianRecipe {
  id          String  @id @default(cuid())
  recipeCode  String  @unique
  recipeName  String
  aliases     String? // comma-separated alternate/regional names
  // macros per 100g
  caloriesPer100g  Float  @default(0)
  proteinPer100g   Float  @default(0)
  carbsPer100g     Float  @default(0)
  fatPer100g       Float  @default(0)
  fibrePer100g     Float  @default(0)
  // standard serving
  servingGrams     Float  @default(100)
  servingName      String @default("1 serving (100g)")
  source      String  @default("INDB")
  dataSource  String? // e.g. "ICMR-NIN IFCT 2017 via INDB"

  @@index([recipeName])
  @@map("indian_recipes")
}

model IndianIngredient {
  id          String  @id @default(cuid())
  foodCode    String  @unique
  foodName    String
  foodGroup   String?
  aliases     String? // alternate regional names (local names from ICMR-NIN)
  // macros per 100g
  caloriesPer100g  Float  @default(0)
  proteinPer100g   Float  @default(0)
  carbsPer100g     Float  @default(0)
  fatPer100g       Float  @default(0)
  fibrePer100g     Float  @default(0)
  source      String  @default("ICMR-NIN")

  @@index([foodName])
  @@map("indian_ingredients")
}

model RecentFoodLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  foodName   String
  foodSource String
  foodData   Json
  usedAt     DateTime @default(now())

  @@index([userId, usedAt])
  @@map("recent_food_logs")
}

model AdditionalMealLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date           String   // "YYYY-MM-DD"
  mealCategory   String   // "breakfast"|"brunch"|"lunch"|"evening_snack"|"dinner"|"other"
  mealTime       String?  // optional, e.g. "10:30 AM"

  foodName       String
  foodSource     String   // "open_food_facts"|"usda"|"ai_estimate"|"manual"
  foodExternalId String?

  servingSize    String
  servingQty     Float
  servingGrams   Float?

  calories       Float
  proteinG       Float
  carbsG         Float
  fatG           Float
  fibreG         Float

  note           String?  @default("")
  isAiEstimate   Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, date, mealCategory])
  @@map("additional_meal_logs")
}

model WaterLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        String
  glasses     Int
  goalGlasses Int

  loggedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("water_logs")
}

model MealCookingInstructions {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  mealPlanId   String
  dayIndex     Int
  mealIndex    Int

  mealName     String
  language     String   @default("en")  // 'en'|'hi'|'kn'|'ta'|'te'

  // Structured content (JSON arrays)
  ingredients  Json     // [{ group, name, quantity, unit, notes }]
  steps        Json     // [{ stepNumber, title, instruction, duration, tip }]
  totalTime    String
  prepTime     String
  cookTime     String
  servings     Int      @default(1)
  tips         String[]
  substitution String?

  // Audio — server-side TTS, file stored in Vercel Blob
  audioUrl         String?   // public URL to the stored .mp3 file
  audioScript      String?   // text sent to TTS (kept for re-generation)
  audioDuration    Int?      // seconds
  audioGeneratedAt DateTime?
  audioProviderUsed String?  // "elevenlabs" | "unreal_speech" | "openai" | "playht"

  generatedAt  DateTime @default(now())

  @@unique([userId, mealPlanId, dayIndex, mealIndex])
  @@index([userId, mealPlanId])
  @@index([userId, mealName])   // reuse lookup: same meal name across plans
  @@map("meal_cooking_instructions")
}

model PlanGenerationUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  month     String   // "YYYY-MM" — calendar month of this generation
  count     Int      @default(0) // full regenerations used this month

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId, month])
  @@map("plan_generation_usage")
}

model MacroValidationLog {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())

  userId        String
  mealPlanId    String
  planDuration  Int
  dayIndex      Int
  mealIndex     Int
  iteration     Int

  claudeMealName        String
  claudeCalories        Float
  claudeProtein         Float
  claudeCarbs           Float
  claudeFat             Float
  claudeFibre           Float
  claudeIngredients     String

  cnQueryString         String
  cnApiSuccess          Boolean
  cnApiStatusCode       Int?
  cnReturnedCalories    Float?
  cnReturnedProtein     Float?
  cnReturnedCarbs       Float?
  cnReturnedFat         Float?
  cnReturnedFibre       Float?
  cnItemsMatched        Int?

  userTargetCalories    Float
  userTargetProtein     Float
  userTargetCarbs       Float
  userTargetFat         Float

  mealTargetCalories    Float
  mealTargetProtein     Float
  mealTargetCarbs       Float
  mealTargetFat         Float

  deltaCalories         Float?
  deltaProtein          Float?
  deltaCarbs            Float?
  deltaFat              Float?
  deltaPctCalories      Float?
  deltaPctProtein       Float?
  deltaPctCarbs         Float?
  deltaPctFat           Float?

  withinTolerance       Boolean

  dayTotalCnCalories    Float?
  dayTotalCnProtein     Float?
  dayTotalCnCarbs       Float?
  dayTotalCnFat         Float?
  dayDeltaCalories      Float?
  dayDeltaPctCalories   Float?
  dayValidationPassed   Boolean?

  correctionTriggered   Boolean   @default(false)
  correctionTargetMeal  String?
  correctionReason      String?
  correctionGapKcal     Float?

  correctedMealName     String?
  correctedCalories     Float?
  correctedProtein      Float?
  correctedCarbs        Float?
  correctedFat          Float?
  correctedFibre        Float?

  recheckCalories           Float?
  recheckProtein            Float?
  recheckCarbs              Float?
  recheckFat                Float?
  recheckWithinTolerance    Boolean?

  finalOutcome          String
  finalCalories         Float
  finalProtein          Float
  finalCarbs            Float
  finalFat              Float
  finalFibre            Float

  accuracyDeltaKcal     Float?
  accuracyDeltaPct      Float?

  // ── New: deviation routing ─────────────────────────────────────────────
  deviationPct          Float?    // |CN - Claude| / Claude × 100
  deviationAction       String?   // accept_cn | scale | regenerate | cn_failure | partial_match_failure
  partialMatchGuard     Boolean   @default(false)  // true if partial match guard triggered

  // ── New: scaling details ───────────────────────────────────────────────
  scalingApplied        Boolean   @default(false)
  scaleFactor           Float?    // e.g. 0.78 means scaled to 78% of original
  postScaleCnCalories   Float?    // CN result after scaling
  postScaleDeviation    Float?    // deviation % after scaling
  scalingResolved       Boolean?  // true = scaling brought it within threshold

  // ── New: secondary meal target check ──────────────────────────────────
  mealTargetCheckPassed    Boolean?  // final meal within ±15% of weighted meal budget
  mealTargetDeviationPct   Float?    // how far final result is from meal budget target (%)

  // ── New: attempt tracking ──────────────────────────────────────────────
  attemptsUsedAtThisMeal   Int?      // value of attempt counter when this meal was processed

  // ── New: day-level correction ──────────────────────────────────────────
  wasDayLevelReplacement     Boolean   @default(false)
  dayTotalBeforeReplacement  Float?    // day calorie total before this replacement
  dayTotalAfterReplacement   Float?    // day calorie total after replacement

  // ── New: extended pipeline observability ───────────────────────────────
  initialDeviationAction  String?   // routing at first CN check, before any escalation
  cnIngredientsSentCount  Int?      // # ingredients in the original CN query string
  scalingSanityFailed     Boolean   @default(false)  // true = post-scale CN > 3× original
  dayMealCount            Int?      // total meals in this day's plan

  // ── New: plan-level slot fast-track ────────────────────────────────────
  cnSlotFailCountAtSkip   Int?      // slot failure count when plan fast-track was triggered

  // ── New: per-macro deviation detail ────────────────────────────────────
  calDeviationPct    Float?   // calorie deviation % (absolute)
  protDeviationPct   Float?   // protein deviation % (absolute)
  carbDeviationPct   Float?   // carb deviation % (absolute)
  fatDeviationPct    Float?   // fat deviation % (absolute, captured not used for routing)
  triggerMacro       String?  // which macro triggered routing: calories|protein|carbs|none

  // ── New: weighted blend scale factor components ─────────────────────────
  calScaleFactor     Float?   // calorie-only scale factor (claude.cal / cn.cal)
  protScaleFactor    Float?   // protein-only scale factor (claude.prot / cn.prot)
  carbScaleFactor    Float?   // carb-only scale factor (claude.carb / cn.carb)
  blendedScaleFactor Float?   // weighted blend before clamping (cal×50%+prot×35%+carb×15%)

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, mealPlanId])
  @@index([mealPlanId, dayIndex, mealIndex])
  @@index([createdAt])
  @@map("macro_validation_logs")
}
