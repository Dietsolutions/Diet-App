# Android release signing configuration
# ----------------------------------------------------------------------------
# Copy this file to `android/app/keystore.properties` (gitignored) and fill
# in the values. The passwords can also be supplied via environment variables
# (ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_PASSWORD) for CI:
#
#   ANDROID_KEYSTORE_FILE=/path/to/release.jks \
#   ANDROID_KEYSTORE_PASSWORD=... \
#   ANDROID_KEY_ALIAS=diet-plan-release \
#   ANDROID_KEY_PASSWORD=... \
#   ./gradlew bundleRelease
#
# See PLAYSTORE_DEPLOY.md for the full Play Store release workflow.
# ----------------------------------------------------------------------------
storeFile=android/app/diet-plan-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=diet-plan-release
keyPassword=YOUR_KEY_PASSWORD
