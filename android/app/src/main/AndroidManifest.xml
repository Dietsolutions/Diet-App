<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom scheme: dietplan:// — matches iOS. Used for native
                 bridges (e.g. Apple Sign-In URL-scheme handoff). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dietplan" />
            </intent-filter>

            <!-- App Links (https://dietplan.app/*) removed for v1: we ship on the
                 free diet-app-gules.vercel.app address and don't own/serve
                 dietplan.app, so autoVerify="true" would fail at install (no
                 .well-known/assetlinks.json), showing a "deep links not verified"
                 warning in Play Console and declaring a domain we can't back.
                 Re-add with the real host + assetlinks.json once a custom domain
                 is live. The custom dietplan:// scheme above (Apple Sign-In
                 handoff) is unaffected. -->
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Core -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Vibration — required by @capacitor/haptics -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- POST_NOTIFICATIONS / RECEIVE_BOOT_COMPLETED / SCHEDULE_EXACT_ALARM removed:
         they belonged to @capacitor/local-notifications, which is uninstalled.
         SCHEDULE_EXACT_ALARM in particular draws Play review scrutiny. -->
</manifest>
