<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production: cleartext is forbidden. The release build
         uses this configuration. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
