# ============================================================================
# Diet Plan & Tracker — environment variables (CANONICAL TEMPLATE)
# ----------------------------------------------------------------------------
# Copy this file to `.env` (root) and to `server/.env` for local development.
#
# On Vercel: set these in Project → Settings → Environment Variables.
# On Android/iOS release: secrets (SMTP, Apple key) live in Vercel. The
# native apps only need build-time PUBLIC vars (VITE_*) baked into the bundle.
#
# A few variables are SECRET-ONLY — they must NEVER be committed to git
# or appear in `.env.example`. The real values go in:
#   • root `.env`         (gitignored — local dev)
#   • `server/.env`       (gitignored — local dev / production runtime)
#   • Vercel project envs (production runtime)
#   • GitHub Actions secrets (CI signing)
# ============================================================================

# ─── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# Pooled connection — used by the runtime via Neon serverless driver.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connection_limit=1"

# Direct (non-pooled) connection — used by Prisma Migrate only.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ──────────────────────────────────────────────────────────────────
# Long random string. Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV="development"          # "production" on Vercel / release builds
PORT="3001"                     # server listen port (local dev only)

# ─── Frontend URL (CORS allowlist + Google OAuth callback) ─────────────────
# Local dev:
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
# Production example:
# CLIENT_URL="https://ai-dpt.vercel.app"
# FRONTEND_URL="https://ai-dpt.vercel.app"

# ─── LLM Provider ──────────────────────────────────────────────────────────
# Primary: Anthropic Claude (set this for direct Claude access)
ANTHROPIC_API_KEY=""
# Optional override (defaults to claude-sonnet-4-20250514)
CLAUDE_MODEL="claude-sonnet-4-20250514"

# Alternative: OpenRouter (auto-selected when OPENROUTER_API_KEY is set)
OPENROUTER_API_KEY=""
OPENROUTER_APP_URL="https://dietplan.app"

# Alternative: OpenAI (used as fallback in some flows)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Rate limit on AI food-photo estimation (per user per day)
AI_FOOD_ESTIMATE_DAILY_LIMIT="50"

# ─── Google OAuth (optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Local dev:
GOOGLE_CALLBACK_URL="http://localhost:5173/api/auth/google/callback"
# Production:
# GOOGLE_CALLBACK_URL="https://ai-dpt.vercel.app/api/auth/google/callback"

# ─── Apple Sign-In (REQUIRED in production if Google sign-in is enabled) ───
# Create a Service ID in Apple Developer → Identifiers → Service IDs
# and a private key under Keys → Sign in with Apple.
APPLE_CLIENT_ID="com.dietplan.tracker.signin"
APPLE_TEAM_ID=""
# Path to the .p8 private key file (do NOT commit this file)
APPLE_PRIVATE_KEY_PATH=""

# ─── SMTP (REQUIRED in production for password-reset emails) ────────────────
# Get credentials from your transactional email provider.
#   Resend:    SMTP_HOST="smtp.resend.com" SMTP_PORT="465" SMTP_USER="resend" SMTP_PASS="re_xxxxx"
#   SendGrid:  SMTP_HOST="smtp.sendgrid.net" SMTP_PORT="587" SMTP_USER="apikey" SMTP_PASS="SG.xxxxx"
#   AWS SES:   SMTP_HOST="email-smtp.us-east-1.amazonaws.com" SMTP_PORT="587" SMTP_USER="..." SMTP_PASS="..."
#   Mailgun:   SMTP_HOST="smtp.mailgun.org" SMTP_PORT="587" SMTP_USER="..." SMTP_PASS="..."
EMAIL_FROM="support@dietplan.app"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ─── Reviewer demo account (production only) ───────────────────────────────
# Auto-created on first server boot when BOTH are set AND NODE_ENV=production.
# Leave empty in development. Provide these to the Play / App Store reviewer.
REVIEW_USERNAME=""
REVIEW_PASSWORD=""

# ─── Client (Vite) — build-time, baked into JS bundle ──────────────────────
# Leave empty when API and frontend share the same origin (default on Vercel).
# Set this if you want the client to talk to a different API host.
VITE_API_URL=""

# PostHog analytics — opt-in only (toggle OFF by default in Profile → Settings).
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# ─── Optional: food databases & media APIs ─────────────────────────────────
CALORIE_NINJAS_API_KEY=""
USDA_API_KEY=""
BLOB_READ_WRITE_TOKEN=""

# ─── Optional: premium TTS providers ───────────────────────────────────────
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
PLAYHT_API_KEY=""
PLAYHT_USER_ID=""
UNREAL_SPEECH_API_KEY=""
UNREAL_SPEECH_VOICE_ID=""

# ─── Seed account (used by `prisma db seed`) ───────────────────────────────
SEED_USERNAME="seeduser"
SEED_PASSWORD="ChangeMe123!"
SEED_NAME="Seed User"

# ─── Android release signing (GitHub Actions secrets, see ios.yml analog) ──
ANDROID_KEYSTORE_FILE="android/app/diet-plan-release.jks"
ANDROID_KEYSTORE_PASSWORD=""
ANDROID_KEY_ALIAS="diet-plan-release"
ANDROID_KEY_PASSWORD=""
