# ============================================================================
# Diet App — environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` (root) and to `server/.env` for local development.
# On Vercel, set these in the project's Environment Variables settings.
# ============================================================================

# --- Database (Neon PostgreSQL) ---------------------------------------------
# Pooled connection — used by the runtime via the Neon serverless adapter.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct (non-pooled) connection — used by Prisma Migrate only.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth -------------------------------------------------------------------
# Long random string. Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# --- Runtime ----------------------------------------------------------------
NODE_ENV="development"
PORT="3001"

# --- Frontend URL (used for CORS allowlist + Google OAuth callback) ---------
# Local dev:
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
# Production example:
# CLIENT_URL="https://your-app.vercel.app"
# FRONTEND_URL="https://your-app.vercel.app"

# --- Anthropic / Claude API -------------------------------------------------
ANTHROPIC_API_KEY=""
# Optional override (defaults to claude-sonnet-4-20250514)
CLAUDE_MODEL="claude-sonnet-4-20250514"

# --- Google OAuth (optional) ------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5173/api/auth/google/callback"

# --- Apple Sign-In (REQUIRED in production if Google sign-in is enabled) ---
# Create a Service ID in Apple Developer → Identifiers → Service IDs
# and a private key under Keys → Sign in with Apple.
APPLE_CLIENT_ID="com.dietplan.tracker.signin"
APPLE_TEAM_ID=""
# Path to the .p8 private key file (do NOT commit this file)
APPLE_PRIVATE_KEY_PATH=""

# --- SMTP (REQUIRED in production for password-reset emails) ----------------
# Get credentials from your transactional email provider (Resend, SendGrid, AWS SES, Mailgun, etc.)
# Examples:
#   Resend:    SMTP_HOST="smtp.resend.com" SMTP_PORT="465" SMTP_USER="resend" SMTP_PASS="re_xxxxx"
#   SendGrid:  SMTP_HOST="smtp.sendgrid.net" SMTP_PORT="587" SMTP_USER="apikey" SMTP_PASS="SG.xxxxx"
EMAIL_FROM="support@dietplan.app"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- App Store / Play Store review account (production only) ----------------
# Set BOTH to auto-create a demo account for the reviewer.
# Leave empty in development to disable.
REVIEW_USERNAME=""
REVIEW_PASSWORD=""

# --- Client (Vite) ----------------------------------------------------------
# Leave empty when API and frontend share the same origin (default on Vercel).
# Set this if you want the client to talk to a different API host.
VITE_API_URL=""

# --- PostHog Analytics (client-only, optional) ------------------------------
# Get your key at https://posthog.com — Project Settings → Project API Key
# Leave empty (or omit) in development to disable analytics; app works identically.
# Production: setting this enables analytics but only after the user opts in
# (opt-in toggle is OFF by default per Apple/Google rules).
VITE_POSTHOG_KEY=""
# Override only if you self-host PostHog; defaults to the US cloud.
VITE_POSTHOG_HOST="https://us.i.posthog.com"
